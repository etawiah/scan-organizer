# scan-organizer environment overrides.
#
# Copy to `.env` (git-ignored) and fill in secrets locally, OR set these as
# environment variables in /etc/default/scan-organizer when running under
# cron / systemd. Never commit a `.env` with real keys.

# Where the mounted scans share lives on this host (defaults to /scans).
# SCANS_ROOT=/mnt/nas/scans

# Which classifier to use: anthropic | gemini | local-keyword
# "local-keyword" is the default and makes zero outbound calls. Switch to
# anthropic or gemini only after reviewing config/private_terms.txt.
SCAN_PROVIDER=local-keyword

# ---- Anthropic ---------------------------------------------------------------
# Required when SCAN_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Model override. Defaults to the cheap, older Haiku 3 tier so we never
# accidentally pay for the newest frontier model. Set this explicitly if
# you want to try a different Claude tier (e.g. claude-3-5-haiku-20241022).
# SCAN_ANTHROPIC_MODEL=claude-3-haiku-20240307

# ---- Gemini ------------------------------------------------------------------
# Required when SCAN_PROVIDER=gemini. GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=

# Model override. Defaults to gemini-2.0-flash (older, cheap Flash tier).
# Avoid defaulting to 2.5 Flash or newer frontier Gemini tiers.
# SCAN_GEMINI_MODEL=gemini-2.0-flash

# ---- Generic override (applies to whichever provider is active) --------------
# SCAN_MODEL=

# Container user:group for docker compose (default 1033:100).
# SCAN_UID_GID=1033:100
