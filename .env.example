# scan-organizer environment overrides.
#
# Copy to `.env` (git-ignored) and fill in secrets locally, OR set these as
# environment variables in /etc/default/scan-organizer when running under
# cron / systemd. Never commit a `.env` with real keys.

# Where the mounted scans share lives on this host (defaults to /scans).
# SCANS_ROOT=/mnt/nas/scans

# Directory searched first for taxonomy.yaml, outbound_vocabulary.txt,
# and private_terms.txt. Docker compose sets this to /config (the
# CONFIG_HOST_PATH bind mount). Unset → /config, /app/config, ./config.
# SCAN_CONFIG_DIR=/config

# Which classifier to use: anthropic | gemini | local-keyword | ollama
# "local-keyword" is the default and makes zero outbound calls. Switch to
# anthropic or gemini only after reviewing config/private_terms.txt.
# "ollama" is local (is_local=True): it sends the full redacted OCR to a
# LAN daemon. OLLAMA_URL must be localhost or an RFC1918/LAN address.
SCAN_PROVIDER=local-keyword

# ---- Anthropic ---------------------------------------------------------------
# Required when SCAN_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Model override. Defaults to the cheap, older Haiku 3 tier so we never
# accidentally pay for the newest frontier model. Set this explicitly if
# you want to try a different Claude tier (e.g. claude-3-5-haiku-20241022).
# SCAN_ANTHROPIC_MODEL=claude-3-haiku-20240307

# ---- Gemini ------------------------------------------------------------------
# Required when SCAN_PROVIDER=gemini. GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=

# Model override. gemini-2.0-flash (and 2.0-flash-lite) shut down
# 2026-06-01. Default is gemini-2.5-flash-lite — oldest cheap Flash
# still listed as live. GEMINI_MODEL wins over SCAN_GEMINI_MODEL /
# SCAN_MODEL / --model.
# GEMINI_MODEL=gemini-2.5-flash-lite
# SCAN_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional extra private terms (comma or newline separated). Never commit
# real names; this is for local / systemd env only. Same matching as the
# gitignored private_terms.txt (case-insensitive, lone given names).
# PRIVATE_TERMS=

# Categories that stay local-only even after redaction (comma-separated
# doc_types). Default: Finance-Bank,ID-Legal,Medical. Empty disables.
# LOCAL_ONLY_CATEGORIES=Finance-Bank,ID-Legal,Medical

# Cap every HTTP request to a cloud provider, including Gemini retries.
# Unset = unlimited. Remaining outbound files go to _Review/ when hit.
# SCAN_MAX_CLOUD_CALLS=20

# Gemini 429/503 retries after the first attempt. Default 3. 0 = --no-retry.
# SCAN_GEMINI_RETRIES=3

# ---- Ollama (local, LAN 192.168.3.x) ----------------------------------------
# One request at a time. Default model qwen2.5:7b-instruct. Timeout default
# 180s, minimum 120s. OCR sent to the model is capped at ~2500 tokens
# (~10k chars) per file. Host must be localhost or RFC1918.
# OLLAMA_URL=http://192.168.x.x:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_TIMEOUT=180

# ---- Generic override (applies to whichever provider is active) --------------
# SCAN_MODEL=

# Container user:group for docker compose (default 1033:100).
# SCAN_UID_GID=1033:100
